#!/usr/bin/env python3
"""Lattice icons: build the theme(s) in the current colours, pick a look, keep them following.

    lattice-icons install [--look LOOK]       build, use the look, follow theme changes, set folder icons
    lattice-icons refresh [--palette FILE]    rebuild in the current colours
    lattice-icons look [LOOK|off]             show or change the look; off stops using Lattice
    lattice-icons folders [--reset]           give home folders (Games, Dropbox…) their icons
    lattice-icons follow on|off               rebuild when the Omarchy theme changes
    lattice-icons build --out DIR [--palette …]
    lattice-icons remove
    lattice-icons status

LOOK is lattice.
Part of asc-icons (design-nexus/asc-icons); drawn from Umbra's catalog and glyphs in this repo.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from umbra import cli  # noqa: E402
from lattice import SET  # noqa: E402

if __name__ == "__main__":
    sys.exit(cli.main(SET))
