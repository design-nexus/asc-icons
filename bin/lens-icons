#!/usr/bin/env python3
"""Lens icons: build the theme(s) in the current colours, pick a look, keep them following.

    lens-icons install [--look LOOK]       build, use the look, follow theme changes, set folder icons
    lens-icons refresh [--palette FILE]    rebuild in the current colours
    lens-icons look [LOOK|off]             show or change the look; off stops using Lens
    lens-icons folders [--reset]           give home folders (Games, Dropbox…) their icons
    lens-icons follow on|off               rebuild when the Omarchy theme changes
    lens-icons build --out DIR [--palette …]
    lens-icons remove
    lens-icons status

LOOK is lens.
Part of asc-icons (design-nexus/asc-icons); drawn from Umbra's catalog and glyphs in this repo.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from umbra import cli  # noqa: E402
from lens import SET  # noqa: E402

if __name__ == "__main__":
    sys.exit(cli.main(SET))
