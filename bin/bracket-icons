#!/usr/bin/env python3
"""Bracket icons: build the theme(s) in the current colours, pick a look, keep them following.

    bracket-icons install [--look LOOK]       build, use the look, follow theme changes, set folder icons
    bracket-icons refresh [--palette FILE]    rebuild in the current colours
    bracket-icons look [LOOK|off]             show or change the look; off stops using Bracket
    bracket-icons folders [--reset]           give home folders (Games, Dropbox…) their icons
    bracket-icons follow on|off               rebuild when the Omarchy theme changes
    bracket-icons build --out DIR [--palette …]
    bracket-icons remove
    bracket-icons status

LOOK is bracket.
Part of asc-icons (design-nexus/asc-icons); drawn from Umbra's catalog and glyphs in this repo.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from umbra import cli  # noqa: E402
from bracket import SET  # noqa: E402

if __name__ == "__main__":
    sys.exit(cli.main(SET))
