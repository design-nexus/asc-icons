#!/usr/bin/env python3
"""Duo icons: build the theme(s) in the current colours, pick a look, keep them following.

    duo-icons install [--look LOOK]       build, use the look, follow theme changes, set folder icons
    duo-icons refresh [--palette FILE]    rebuild in the current colours
    duo-icons look [LOOK|off]             show or change the look; off stops using Duo
    duo-icons folders [--reset]           give home folders (Games, Dropbox…) their icons
    duo-icons follow on|off               rebuild when the Omarchy theme changes
    duo-icons build --out DIR [--palette …]
    duo-icons remove
    duo-icons status

LOOK is duo.
Part of asc-icons (design-nexus/asc-icons); drawn from Umbra's catalog and glyphs in this repo.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from umbra import cli  # noqa: E402
from duo import SET  # noqa: E402

if __name__ == "__main__":
    sys.exit(cli.main(SET))
